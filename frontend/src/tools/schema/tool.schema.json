{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sp-ai-portal.local/schemas/tool.schema.json",
  "title": "SP AI Portal Tool Definition",
  "type": "object",
  "required": [
    "schemaVersion", "kind", "id", "slug", "name", "tagline", "description",
    "version", "updatedAt", "maintainer", "maturity", "inputs", "outputs",
    "boundaries", "deployment", "trial", "runtime"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "kind": { "const": "tool" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 2 },
    "tagline": { "type": "string", "minLength": 4 },
    "description": { "type": "string", "minLength": 8 },
    "accent": { "type": "string" },
    "icon": { "enum": ["document", "headset", "tools"] },
    "version": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "format": "date" },
    "maintainer": { "type": "string", "minLength": 2 },
    "maturity": { "type": "string", "minLength": 2 },
    "tags": { "type": "array", "items": { "type": "string" }, "default": [] },
    "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" }, "default": [] },
    "inputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/io" } },
    "outputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/io" } },
    "qualityChecks": { "type": "array", "items": { "type": "string" }, "default": [] },
    "boundaries": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "deployment": { "$ref": "#/$defs/deployment" },
    "trial": { "$ref": "#/$defs/trial" },
    "runtime": { "$ref": "#/$defs/runtime" }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "required": ["value", "label"],
      "properties": { "value": { "type": "string" }, "label": { "type": "string" } },
      "additionalProperties": false
    },
    "io": {
      "type": "object",
      "required": ["name", "detail"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 2 },
        "formats": { "type": "string" }
      },
      "additionalProperties": false
    },
    "deployment": {
      "type": "object",
      "required": ["available", "modes", "environment", "guide"],
      "properties": {
        "available": { "type": "boolean" },
        "modes": { "type": "array", "items": { "type": "string" } },
        "environment": { "type": "string" },
        "guide": { "type": "string" }
      },
      "additionalProperties": false
    },
    "trial": {
      "type": "object",
      "required": [
        "enabled", "mode", "prototype", "actualFileTransfer", "acceptedExtensions",
        "maxFileSizeMB", "retentionHours", "processingLocation", "externalProviders",
        "requireHumanReview", "resultWatermark", "steps", "templates", "sample", "qualityDimensions"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "enum": ["disabled", "sample-only", "sandbox-upload", "browser-local"] },
        "prototype": { "type": "boolean" },
        "actualFileTransfer": { "type": "boolean" },
        "acceptedExtensions": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+$" } },
        "maxFileSizeMB": { "type": "number", "exclusiveMinimum": 0 },
        "retentionHours": { "type": "number", "minimum": 0 },
        "processingLocation": { "type": "string" },
        "externalProviders": { "type": "array", "items": { "type": "string" } },
        "requireHumanReview": { "type": "boolean" },
        "resultWatermark": { "type": "string" },
        "steps": { "type": "array", "items": { "type": "string" } },
        "templates": { "type": "array", "items": { "type": "string" } },
        "sample": { "type": "object" },
        "qualityDimensions": { "type": "array", "items": { "type": "object" } }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["renderer", "executionMode", "route", "fileLimitMB", "securityStatement", "supportNotes", "operations"],
      "properties": {
        "renderer": { "enum": ["document-transform", "custom"] },
        "executionMode": { "enum": ["browser-local", "server-job"] },
        "route": { "type": "string", "pattern": "^/tools/" },
        "fileLimitMB": { "type": "number", "exclusiveMinimum": 0 },
        "securityStatement": { "type": "string", "minLength": 8 },
        "sampleMarkdown": { "type": "string" },
        "supportNotes": { "type": "array", "items": { "type": "string" } },
        "operations": { "type": "array", "items": { "$ref": "#/$defs/operation" } }
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": ["id", "label", "from", "to", "hint", "executor", "input", "output"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "type": "string" },
        "from": { "type": "string" },
        "to": { "type": "string" },
        "hint": { "type": "string" },
        "executor": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "input": {
          "type": "object",
          "required": ["kind", "accept", "heading", "description"],
          "properties": {
            "kind": { "enum": ["markdown", "file"] },
            "accept": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z0-9]+$" } },
            "heading": { "type": "string" },
            "description": { "type": "string" }
          },
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "required": ["kind", "format", "actionLabel"],
          "properties": {
            "kind": { "enum": ["file", "markdown"] },
            "format": { "type": "string" },
            "actionLabel": { "type": "string" }
          },
          "additionalProperties": false
        },
        "notices": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
