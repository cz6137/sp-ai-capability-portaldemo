# IMA OpenAPI settings (kept only on the local bridge computer)
IMA_BASE_URL=https://ima.qq.com
IMA_CLIENT_ID=replace-me
IMA_API_KEY=replace-me
IMA_KNOWLEDGE_BASE_ID=replace-me
IMA_SHARE_ID=replace-me
# Optional: start traversal below a specific IMA folder
IMA_ROOT_FOLDER_ID=

# Intranet backend context URL, without /api/v1
PORTAL_BASE_URL=http://intranet-host:8080/sp-ai-portal
PORTAL_USERNAME=admin
PORTAL_PASSWORD=replace-me

BRIDGE_BATCH_SIZE=50
BRIDGE_TIMEOUT_MS=45000
BRIDGE_RETRIES=3
# IMA read throttling and rate-limit recovery
IMA_PAGE_SIZE=50
IMA_REQUEST_INTERVAL_MS=1500
IMA_STAGE_PAUSE_MS=2000
IMA_RATE_LIMIT_RETRIES=10
IMA_RATE_LIMIT_BACKOFF_MS=10000
# Each IMA document is downloaded locally and uploaded to the portal GridFS bucket
IMA_FILE_RETRIES=3
IMA_MAX_FILE_SIZE_MB=300
# Safety check: a normal full snapshot must discover these stage roots
BRIDGE_REQUIRED_STAGES=0,1,2,3,4,5,6,7,8
